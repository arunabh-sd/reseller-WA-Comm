# WhatsApp community group name (exact string as it appears in WA)
WA_COMMUNITY_GROUP_NAME=ShopDeck Resellers

# Metabase
METABASE_URL=https://metabase.kaip.in
METABASE_API_KEY=your_api_key_here

# Existing Metabase cards (pre-wired, no changes needed)
# Card 14565: product signals (views, shares, reseller_orders)
# Card 13784: product catalogue (category, desc, price)

# User-provided question IDs (fill in once created in Metabase)
# Expected columns: customer_product_short_id, image_url, l30d_orders, l7d_views, l7d_shares
METABASE_PRODUCT_QUESTION_ID=

# Question with performance data for products shared (for daily learning)
# Expected columns: customer_product_short_id, reseller_orders, product_shares, product_views
METABASE_PERFORMANCE_QUESTION_ID=

# Data directory (Railway volume mount path)
DATA_DIR=/app/data

# Auth directory (Railway volume mount path)
AUTH_DIR=/app/auth

# QR / health server port
PORT=3000
